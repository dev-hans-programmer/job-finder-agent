APP_ENV=local
APP_NAME=job-radar-agent
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://jobradar:jobradar@localhost:5432/jobradar
REDIS_URL=redis://localhost:6379/0
SCHEDULER_POLL_SECONDS=30
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
OTEL_ENABLED=false
OTEL_SERVICE_NAME=job-radar-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATE=1.0
# Docker Compose overrides this to the local collector endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
DEFAULT_TIMEZONE=Asia/Kolkata
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_FAIL_OPEN=true
# Only trust X-Forwarded-For when the direct peer is listed here.
TRUSTED_PROXY_IPS=
