APP_ENV=production
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=replace-with-a-secret-from-your-secret-manager
JWT_SECRET_KEY=replace-with-a-long-random-production-secret
PRODUCTION_IMAGE=ghcr.io/your-org/job-radar-agent
PRODUCTION_IMAGE_TAG=production
OTEL_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
